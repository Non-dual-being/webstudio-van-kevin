# CONCEPT: never activate without filling private credentials and reviewing the runbook.
# Create privately on the VPS; never copy the development .env or this file as-is.
APP_NAME="Kevin Webstudio"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kevinwebstudio.nl
APP_KEY=REPLACE_WITH_NEW_PRODUCTION_KEY
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=sqlite
DB_DATABASE=@@SITE_ROOT@@/shared/database/contact.sqlite
DB_URL=null
DB_FOREIGN_KEYS=true
CACHE_STORE=database
CONTACT_CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=sqlite
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_CONNECTION=sqlite
SESSION_COOKIE=__Host-kevin_webstudio_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
MAIL_MAILER=smtp
MAIL_URL=null
MAIL_SCHEME=smtps
MAIL_HOST=smtp.transip.email
MAIL_PORT=465
MAIL_USERNAME=REPLACE_PRIVATELY
MAIL_PASSWORD=REPLACE_PRIVATELY
MAIL_FROM_ADDRESS=info@kevinwebstudio.nl
MAIL_FROM_NAME="Kevin Webstudio"
MAIL_EHLO_DOMAIN=kevinwebstudio.nl
STUDIO_MAIL_TO_ADDRESS=info@kevinwebstudio.nl
STUDIO_MAIL_RECEIPT_FROM_NAME="Kevin | Kevin Webstudio"
CONTACT_ALLOW_TEST_TRANSPORT=false
CONTACT_IP_LIMIT=12
CONTACT_EMAIL_LIMIT=3
CONTACT_LIMIT_SECONDS=3600
# No CONTACT_RETENTION_DAYS until approved; never auto-schedule deletion.
EDUCATION_DEMO_ENABLED=false
